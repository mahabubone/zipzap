{
  "name": "@zipzap/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "GENERATED from the backend OpenAPI spec. Never hand-edit — regenerate.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "openapi-typescript ../../apps/backend/openapi.json -o src/generated.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pretest": "pnpm generate"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
