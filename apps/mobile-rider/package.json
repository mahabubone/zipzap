{
  "name": "@zipzap/rider",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "verify:queue": "node scripts/verify-queue.mjs",
    "verify:client": "node scripts/verify-client.mjs",
    "test": "vitest run",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tanstack/react-query": "^5.80.0",
    "@zipzap/api-client": "workspace:*",
    "expo": "^52.0.0",
    "expo-image-picker": "^16.0.6",
    "expo-linear-gradient": "^57.0.2",
    "expo-secure-store": "15.0.7",
    "react": "19.3.0",
    "react-native": "0.76.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^8.0.7",
    "@expo/metro-runtime": "~4.0.1",
    "@types/node": "24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-native": "^0.73.0",
    "playwright-core": "1.48.2",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
