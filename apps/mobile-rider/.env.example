# Where the rider app sends its requests.
#
# Unlike the web consoles this is a cross-origin absolute URL, not a same-origin `/api`: a native
# app has no server of its own to proxy through, so it talks to the API directly and authenticates
# with a bearer token from POST /v1/auth/token — the cookie flow is for browsers, and a native app
# cannot hold one.
#
# `https` in every deployed environment: `usesCleartextTraffic` is false on Android, so a plain
# `http://` origin will fail at request time with no useful message.
EXPO_PUBLIC_API_URL=http://localhost:3000
