  "info": {
    "title": "ZipZap API",
    "description": "Logistics operating system for e-commerce fulfillment and last-mile delivery.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateWebhookDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "url",
          "events"
        ]
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "shipments:read",
                "shipments:write",
                "tracking:read",
                "pickup:create",
                "pickup:read",
                "delivery:create",
                "delivery:read",
                "delivery:complete",
                "returns:read",
                "returns:write",
                "cod:read",
                "settlements:read",
                "settlements:approve",
                "webhooks:manage",
                "keys:manage"
              ]
            }
          }
        },
        "required": [
          "scopes"
        ]
      },
      "CreateShipmentDto": {
        "type": "object",
        "properties": {
          "senderName": {
            "type": "string",
            "maxLength": 120
          },
          "senderPhone": {
            "type": "string",
            "pattern": "^\\+8801[3-9]\\d{8}$"
          },
          "senderAddress": {
            "type": "string",
            "maxLength": 400
          },
          "recipientName": {
            "type": "string",
            "maxLength": 120
          },
          "recipientPhone": {
            "type": "string",
            "pattern": "^\\+8801[3-9]\\d{8}$"
          },
          "recipientAddress": {
            "type": "string",
            "maxLength": 400
          },
          "parcelWeightGrams": {
            "type": "number",
            "minimum": 1
          },
          "parcelDescription": {
            "type": "string",
            "maxLength": 200
          },
          "codAmountMinor": {
            "type": "number",
            "description": "Money as integer minor units. A decimal here is a bug, not a convenience.",
            "minimum": 1
          },
          "codCurrency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "zone": {
            "type": "string",
            "maxLength": 80
          },
          "remoteArea": {
            "type": "boolean"
          },
          "fragile": {
            "type": "boolean"
          },
          "packagingKind": {
            "type": "string",
            "maxLength": 40
          },
          "merchantPlan": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "senderName",
          "senderPhone",
          "senderAddress",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "parcelWeightGrams",
          "parcelDescription",
          "zone",
          "remoteArea",
          "fragile",
          "merchantPlan"
        ]
      },
      "UploadBulkDto": {
        "type": "object",
        "properties": {
          "csv": {
            "type": "string",
            "maxLength": 10000000
          },
          "filename": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "csv",
          "filename"
        ]
      },
      "AcceptBulkDto": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          }
        },
        "required": [
          "jobId"
        ]
      },
      "ReportExceptionDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "LOST",
              "DAMAGED"
            ]
          },
          "note": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      },
      "QuoteDto": {
        "type": "object",
        "properties": {
          "weightGrams": {
            "type": "number",
            "minimum": 1
          },
          "codAmountMinor": {
            "type": "number",
            "minimum": 0
          },
          "zone": {
            "type": "string",
            "maxLength": 80
          },
          "remoteArea": {
            "type": "boolean"
          },
          "fragile": {
            "type": "boolean"
          },
          "packagingKind": {
            "type": "string",
            "maxLength": 40
          },
          "merchantPlan": {
            "type": "string",
            "maxLength": 40
          },
          "currency": {
            "type": "string",
            "enum": [
              "BDT"
            ],
            "pattern": "^[A-Z]{3}$"
          },
          "version": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "weightGrams",
          "codAmountMinor",
          "zone",
          "remoteArea",
          "fragile",
          "merchantPlan"
        ]
      },
      "CollectCodDto": {
        "type": "object",
        "properties": {
          "shipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "collectedMinor": {
            "type": "number",
            "description": "Integer minor units. A decimal here is a bug, not a convenience.",
            "minimum": 0
          }
        },
        "required": [
          "shipmentId",
          "collectedMinor"
        ]
      },
      "ReconcileCodDto": {
        "type": "object",
        "properties": {
          "shipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          }
        },
        "required": [
          "shipmentId",
          "note"
        ]
      },
      "RequestPickupDto": {
        "type": "object",
        "properties": {
          "shipmentIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "totalWeightGrams": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "shipmentIds",
          "totalWeightGrams"
        ]
      },
      "AssignmentCandidateDto": {
        "type": "object",
        "properties": {
          "riderId": {
            "type": "string",
            "format": "uuid"
          },
          "distanceMetres": {
            "type": "number",
            "nullable": true,
            "minimum": 0
          },
          "activeJobs": {
            "type": "number",
            "minimum": 0
          },
          "capacity": {
            "type": "number",
            "minimum": 1
          },
          "recentRefusals": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "riderId"
        ]
      },
      "AssignPickupDto": {
        "type": "object",
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssignmentCandidateDto"
            }
          }
        },
        "required": [
          "candidates"
        ]
      },
      "RegisterRiderDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+8801[3-9]\\d{8}$"
          },
          "capacity": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "displayName",
          "phone"
        ]
      },
      "AckDto": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string"
          }
        },
        "required": [
          "commandId"
        ]
      },
      "RecordAttemptDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "CUSTOMER_UNAVAILABLE",
              "WRONG_ADDRESS",
              "PHONE_UNREACHABLE",
              "CUSTOMER_REFUSED",
              "ADDRESS_INCOMPLETE",
              "PAYMENT_ISSUE",
              "DAMAGED_PACKAGE",
              "WEATHER",
              "OPERATIONAL_EXCEPTION"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      },
      "CreateDeliveryDto": {
        "type": "object",
        "properties": {
          "shipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "riderId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "shipmentId"
        ]
      },
      "CompleteDeliveryDto": {
        "type": "object",
        "properties": {
          "collectedMinor": {
            "type": "number",
            "description": "Integer minor units collected at the door. A decimal here is a bug, not a convenience.",
            "minimum": 0
          }
        },
        "required": [
          "collectedMinor"
        ]
      },
      "CreateSettlementDto": {
        "type": "object",
        "properties": {
          "merchantId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "merchantId"
        ]
      },
      "ApproveSettlementDto": {
        "type": "object",
        "properties": {
          "approverId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "approverId"
        ]
      },
      "RequestReturnDto": {
        "type": "object",
        "properties": {
          "shipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "enum": [
              "CUSTOMER_REFUSED",
              "CUSTOMER_UNAVAILABLE",
              "WRONG_ADDRESS",
              "DAMAGED",
              "MERCHANT_REQUEST",
              "OTHER"
            ]
          }
        },
        "required": [
          "shipmentId",
          "reason"
        ]
      },
      "DecideReturnDto": {
        "type": "object",
        "properties": {
          "approverId": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          }
        },
        "required": [
          "approverId",
          "note"
        ]
      },
      "HubScanDto": {
        "type": "object",
        "properties": {
          "shipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "scan": {
            "type": "string",
            "enum": [
              "INBOUND",
              "SORT",
              "OUTBOUND",
              "DEPARTED",
              "ARRIVED"
            ]
          },
          "hubCode": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "shipmentId",
          "scan"
        ]
      }
    }
  }
}
