{
  "name": "@zipzap/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ZipZap API, worker and publisher \u2014 one NestJS codebase, three entrypoints",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "node scripts/dev.mjs",
    "start:api": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "start:publisher": "node --env-file-if-exists=../../.env dist/publisher.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-transform-types --test \"test/*.test.ts\"",
    "db:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "db:migrate": "node --env-file-if-exists=../../.env dist/database/cli.js migrate",
    "db:revert": "node --env-file-if-exists=../../.env dist/database/cli.js revert",
    "db:seed": "node --env-file-if-exists=../../.env dist/database/cli.js seed",
    "test:integration": "node --experimental-transform-types --test \"test/integration/*.test.ts\""
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/typeorm": "12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nats": "2.29.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "typescript": "6.0.3"
  }
}
