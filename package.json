{
  "name": "zipzap",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:sync": "turbo run openapi:export generate",
    "api:check": "pnpm api:sync && git diff --exit-code -- apps/backend/openapi.json apps/backend/openapi.yaml packages/api-client/src/generated.d.ts",
    "docs:dev": "pnpm --filter @zipzap/site dev",
    "docs:build": "turbo run build --filter=@zipzap/site",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "build": "turbo run build",
    "db:migrate": "pnpm --filter @zipzap/backend db:migrate",
    "db:revert": "pnpm --filter @zipzap/backend db:revert",
    "db:seed": "pnpm --filter @zipzap/backend db:seed",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "infra:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/compose/docker-compose.yml logs -f",
    "infra:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up -d",
    "demo:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml --profile app down",
    "demo:logs": "docker compose --env-file .env -f infra/compose/docker-compose.yml --profile app logs -f",
    "demo:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml --profile app up -d --build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm boundaries:check && pnpm format:check && pnpm typecheck && pnpm test",
    "storybook": "pnpm --filter @zipzap/ui storybook"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.6",
    "typescript": "6.0.3"
  }
}
