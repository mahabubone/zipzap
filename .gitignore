# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
export/
*.tsbuildinfo

# Turbo
.turbo/

# TanStack Start dev cache
.tanstack/

# Test output
coverage/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local database volumes
infra/compose/**/data/

# Repository Custom needs
prompt.txt

# Expo web export + local caches (regenerate with `expo export`)
apps/mobile-rider/dist-web/
apps/mobile-rider/.expo-cache/
apps/mobile-rider/.expohome/
apps/mobile-rider/.cache/
apps/mobile-rider/.tmp/

# `expo prebuild` output. Regenerated locally; the native projects are machine-written and
# their contents are decided by the Expo SDK, not by us, so committing them would make
# every SDK upgrade a large diff of Xcode and Gradle files. See apps/mobile-rider/README.md.
apps/mobile-rider/ios/
apps/mobile-rider/android/

# Docs site
apps/site/dist/
apps/site/.astro/
apps/site/public/openapi.json

# Agent worktrees. A nested checkout of the same repo — committing it would either duplicate the
# whole history or record thousands of files that belong to a throwaway branch. See the note in
# state.md about running agents out of tree.
.kilo/

# A `dist/` a build ran as root could not delete. `nest build` moves the old output dir aside
# before writing (`deleteOutDir: true`) and gives up quietly when it lacks permission, so the
# renamed original is left behind as `dist.<something>`. It is build output that happens to have
# escaped the `dist/` rule above.
apps/backend/dist.*/

