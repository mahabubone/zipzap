# Copy to .env and adjust. Never commit a filled-in .env.
#
# Every value below has a working default in infra/compose/docker-compose.yml, so
# `cp .env.example .env` with no editing is enough to run `pnpm demo:up`. Change one only when your
# machine needs it — a port another stack already holds, or a secret you generated.

NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS — matches infra/compose/docker-compose.yml
DATABASE_URL=postgresql://zipzap:zipzap@localhost:5432/zipzap

# Redis — cache, rate limiting, idempotency short-lived state
REDIS_URL=redis://localhost:6379

# NATS JetStream — event transport, never a source of truth
NATS_URL=nats://localhost:4222
NATS_STREAM=ZIPZAP

# Host ports for infra/compose. Defaults are conventional; override when they are taken by
# another stack on the same machine — and change the matching URL above to match.
#
# These matter for `pnpm infra:up` and `pnpm dev`, which run on the host. The containers in the
# `app` profile never read them: they reach Postgres, Redis and NATS by service name, so their
# wiring is identical on every machine.
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Host ports for the `app` profile — `pnpm demo:up`. Same rule: change one and the containers still
# find each other, because they address each other by service name.
#
# The two web ports deliberately equal the Vite dev ports, and are published on BOTH sides of the
# mapping. That is not a convention: the merchant console's server-side guard
# (apps/frontends/merchant-web/src/routes/app.tsx) resolves its relative `/api` base URL against
# the origin the browser used and fetches it back, so the app must be able to reach ITSELF on the
# port it is published on. The compose file writes them `${VAR:-default}:${VAR:-default}` so changing
# one moves both halves together.
#
# The backend's 9090/9091 metrics ports are deliberately NOT reused here: Prometheus already owns
# host 9090, so the worker and publisher are published on 9092 and 9093 instead.
API_PORT=3000
WORKER_METRICS_PORT=9092
PUBLISHER_METRICS_PORT=9093
MERCHANT_WEB_PORT=5173
TRACKING_WEB_PORT=5174

# Containers only. `pnpm demo:up` runs NODE_ENV=production inside them, which is what the variable
# is for; set this to development to get the interactive Swagger UI at /docs back while poking at a
# containerised API. `/docs-json` and `/docs-yaml` are served either way.
APP_NODE_ENV=production

# Set to disable outbound calls in local dev
NOTIFICATIONS_ENABLED=false
WEBHOOKS_ENABLED=true

# Payout rail: mock moves no money; paystation talks to PAYSTATION_URL
# (the fake locally, the gateway in staging). Published sandbox credentials.
PAYMENT_PROVIDER=mock
PAYSTATION_URL=http://localhost:4010
PAYSTATION_MERCHANT_ID=104-1653730183
PAYSTATION_PASSWORD=gamecoderstorepass

# SMS rail: mock sends nothing; mimsms talks to MIMSMS_URL
# (the fake locally, the gateway in staging). Published demo credentials.
SMS_PROVIDER=mock
MIMSMS_URL=http://localhost:4010
MIMSMS_API_KEY=J6J68SNLDYG1SVS
MIMSMS_USERNAME=demo@mimsms.com
MIMSMS_SENDER=8809612444598

# Observability — leave empty to disable
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=zipzap-backend

# Prometheus scrape ports for the two background entrypoints.
# The API serves GET /metrics on PORT itself; the worker and publisher have
# no other HTTP surface, so each hosts a lean metrics-only server.
METRICS_PORT=9090
PUBLISHER_METRICS_PORT=9091

# Secrets — generate with: openssl rand -base64 48
API_SECRET_ENCRYPTION_KEY=
SESSION_SECRET=

# Origins allowed to call this API from a browser. Comma-separated.
#
# The consoles (merchant-web, control-tower, hub-console) proxy /api to this
# server, so they send no cross-origin request and need no entry here. Set it
# when a frontend is served from a different origin than the API, or when a
# partner frontend needs browser access.
#
# Unset or empty = cross-origin browser calls are rejected. Same-origin
# requests, and any server-to-server caller, are unaffected. It used to be
# absent from this file entirely, so an unconfigured run reflected ANY origin
# back — an allowlist maintained by the caller.
WEB_ORIGIN=http://localhost:5173,http://localhost:5174

# libuv threadpool slots — the async scrypt API-key verify runs here; 8 matches
# the default load-test concurrency (docs/operations/performance.md)
UV_THREADPOOL_SIZE=8
